{
  "$defs": {
    "ActionCall": {
      "additionalProperties": false,
      "description": "Declarative action invocation, without function pointers or a registry.",
      "properties": {
        "action_id": {
          "description": "Symbolic action vocabulary key.",
          "type": "string"
        },
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/DataValue"
          },
          "description": "Named tagged arguments.",
          "type": "object"
        }
      },
      "required": [
        "action_id",
        "args"
      ],
      "type": "object"
    },
    "DataValue": {
      "description": "Explicitly tagged values; signed and unsigned integers remain distinct.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Boolean value.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Signed integer.",
          "properties": {
            "type": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Unsigned integer.",
          "properties": {
            "type": {
              "const": "unsigned",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Raw fixed-point integer on the wire.",
          "properties": {
            "type": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Literal text, including Unicode.",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Authored-object reference.",
          "properties": {
            "type": {
              "const": "object_ref",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/UlidText"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered heterogeneous values.",
          "properties": {
            "type": {
              "const": "list",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Lexically keyed heterogeneous values.",
          "properties": {
            "type": {
              "const": "map",
              "type": "string"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Edge": {
      "additionalProperties": false,
      "description": "Ordered graph connection; endpoint validation is deferred to T011.",
      "properties": {
        "from": {
          "$ref": "#/$defs/UlidText",
          "description": "Source node identity."
        },
        "port": {
          "$ref": "#/$defs/Port",
          "description": "Source output port."
        },
        "to": {
          "$ref": "#/$defs/UlidText",
          "description": "Destination node identity."
        }
      },
      "required": [
        "from",
        "port",
        "to"
      ],
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "description": "Identified graph node.",
      "properties": {
        "body": {
          "$ref": "#/$defs/NodeBody",
          "description": "Declarative operation."
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable node identity."
        }
      },
      "required": [
        "id",
        "body"
      ],
      "type": "object"
    },
    "NodeBody": {
      "description": "Stored operation; expressions remain opaque until later compilation.\n\nDeserialization rejects unknown fields for every variant, including unit\nshapes, for the same internally tagged reason documented on [`Trigger`].",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Evaluate a condition with true/false ports.",
          "properties": {
            "expr": {
              "description": "Opaque expression.",
              "type": "string"
            },
            "kind": {
              "const": "condition",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "expr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Invoke an action with a next port.",
          "properties": {
            "call": {
              "$ref": "#/$defs/ActionCall",
              "description": "Symbolic action and arguments."
            },
            "kind": {
              "const": "action",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Branch through zero-based case ports.",
          "properties": {
            "cases": {
              "description": "Cases in authored order.",
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            },
            "expr": {
              "description": "Opaque expression.",
              "type": "string"
            },
            "kind": {
              "const": "branch",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "expr",
            "cases"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered references to nodes in this graph.",
          "properties": {
            "kind": {
              "const": "sequence",
              "type": "string"
            },
            "nodes": {
              "description": "Child node identities, in execution order.",
              "items": {
                "$ref": "#/$defs/UlidText"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "nodes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Wait a relative tick count; no absolute scheduling occurs here.",
          "properties": {
            "kind": {
              "const": "wait",
              "type": "string"
            },
            "ticks": {
              "description": "Relative ticks, including zero and the full unsigned range.",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "ticks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Call a script vocabulary entry.",
          "properties": {
            "args": {
              "additionalProperties": {
                "$ref": "#/$defs/DataValue"
              },
              "description": "Named tagged arguments.",
              "type": "object"
            },
            "kind": {
              "const": "call_script",
              "type": "string"
            },
            "script_id": {
              "description": "Symbolic script key.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "script_id",
            "args"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Call another authored graph.",
          "properties": {
            "args": {
              "additionalProperties": {
                "$ref": "#/$defs/DataValue"
              },
              "description": "Named tagged arguments.",
              "type": "object"
            },
            "graph_id": {
              "$ref": "#/$defs/UlidText",
              "description": "Authored graph identity."
            },
            "kind": {
              "const": "call_graph",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "graph_id",
            "args"
          ],
          "type": "object"
        }
      ]
    },
    "Port": {
      "description": "Output port of a graph node.\n\nDeserialization rejects unknown fields for every variant, including unit\nshapes, for the same internally tagged reason documented on [`Trigger`].",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Sequential continuation.",
          "properties": {
            "kind": {
              "const": "next",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Condition succeeds.",
          "properties": {
            "kind": {
              "const": "true",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Condition fails.",
          "properties": {
            "kind": {
              "const": "false",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Branch case.",
          "properties": {
            "index": {
              "description": "Zero-based authored case position.",
              "format": "uint32",
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "case",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "index"
          ],
          "type": "object"
        }
      ]
    },
    "Trigger": {
      "description": "Declarative initiating event; symbolic custom ids are not object ids.\n\nDeserialization rejects unknown fields for every variant, including unit\nvariants where serde's derived `deny_unknown_fields` would otherwise ignore\ntrailing fields on internally tagged enums.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Entering an area.",
          "properties": {
            "kind": {
              "const": "area_enter",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Leaving an area.",
          "properties": {
            "kind": {
              "const": "area_exit",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Interacting with an object.",
          "properties": {
            "kind": {
              "const": "interact",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entering a dialogue node.",
          "properties": {
            "kind": {
              "const": "dialogue_node",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Changing quest state.",
          "properties": {
            "kind": {
              "const": "quest_state_change",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Relative tick timer.",
          "properties": {
            "kind": {
              "const": "timer",
              "type": "string"
            },
            "ticks": {
              "description": "Relative ticks, including zero and the full unsigned range.",
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "ticks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Starting combat.",
          "properties": {
            "kind": {
              "const": "combat_start",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ending combat.",
          "properties": {
            "kind": {
              "const": "combat_end",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Death event.",
          "properties": {
            "kind": {
              "const": "death",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Acquiring an item.",
          "properties": {
            "kind": {
              "const": "item_acquired",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Extension vocabulary trigger.",
          "properties": {
            "id": {
              "description": "Symbolic vocabulary key.",
              "type": "string"
            },
            "kind": {
              "const": "custom",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    },
    "ValueType": {
      "description": "Declarative value category; containers hold tagged heterogeneous values.",
      "oneOf": [
        {
          "const": "bool",
          "description": "Boolean.",
          "type": "string"
        },
        {
          "const": "integer",
          "description": "Signed integer.",
          "type": "string"
        },
        {
          "const": "unsigned",
          "description": "Unsigned integer.",
          "type": "string"
        },
        {
          "const": "fixed",
          "description": "Fixed-point value.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Text.",
          "type": "string"
        },
        {
          "const": "object_ref",
          "description": "Authored-object reference.",
          "type": "string"
        },
        {
          "const": "list",
          "description": "Ordered tagged values.",
          "type": "string"
        },
        {
          "const": "map",
          "description": "Named tagged values.",
          "type": "string"
        }
      ]
    },
    "VarDecl": {
      "additionalProperties": false,
      "description": "Authored variable declaration; default-type consistency is a T011 check.",
      "properties": {
        "default": {
          "$ref": "#/$defs/DataValue",
          "description": "Initial tagged value."
        },
        "name": {
          "description": "Symbolic variable name.",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/VariableScope",
          "description": "Owning scope."
        },
        "value_type": {
          "$ref": "#/$defs/ValueType",
          "description": "Declared category."
        }
      },
      "required": [
        "name",
        "value_type",
        "default",
        "scope"
      ],
      "type": "object"
    },
    "VariableScope": {
      "description": "Ownership scope of a declared variable.",
      "oneOf": [
        {
          "const": "campaign",
          "description": "Campaign state.",
          "type": "string"
        },
        {
          "const": "world",
          "description": "World state.",
          "type": "string"
        },
        {
          "const": "area",
          "description": "Area state.",
          "type": "string"
        },
        {
          "const": "graph",
          "description": "Graph-local state.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "An independently stored or aggregate-owned authored event graph.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "edges": {
          "description": "Connections in authored order.",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        },
        "entry": {
          "$ref": "#/$defs/Trigger",
          "description": "Initiating trigger."
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "locals": {
          "description": "Graph-local declarations.",
          "items": {
            "$ref": "#/$defs/VarDecl"
          },
          "type": "array"
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "nodes": {
          "description": "Nodes in authored order.",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        },
        "schema": {
          "const": "crpg.graph/1",
          "type": "string"
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/UlidText",
          "description": "First node identity."
        }
      },
      "required": [
        "schema",
        "id",
        "slug",
        "name",
        "entry",
        "start",
        "nodes",
        "edges",
        "locals"
      ],
      "type": "object"
    }
  ],
  "title": "EventGraph"
}
