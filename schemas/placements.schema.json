{
  "$defs": {
    "DataValue": {
      "description": "Explicitly tagged values; signed and unsigned integers remain distinct.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Boolean value.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Signed integer.",
          "properties": {
            "type": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Unsigned integer.",
          "properties": {
            "type": {
              "const": "unsigned",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Raw fixed-point integer on the wire.",
          "properties": {
            "type": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Literal text, including Unicode.",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Authored-object reference.",
          "properties": {
            "type": {
              "const": "object_ref",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/UlidText"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered heterogeneous values.",
          "properties": {
            "type": {
              "const": "list",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Lexically keyed heterogeneous values.",
          "properties": {
            "type": {
              "const": "map",
              "type": "string"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Placement": {
      "additionalProperties": false,
      "description": "Identified placed prefab instance, stored only inside an aggregate.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/DataValue"
          },
          "description": "Named tagged overrides.",
          "type": "object"
        },
        "prefab": {
          "$ref": "#/$defs/UlidText",
          "description": "Prefab object identity."
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Transform",
          "description": "Authored fixed-point transform."
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "prefab",
        "transform",
        "overrides"
      ],
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "description": "Authored fixed-point transform, independent of runtime spatial storage.",
      "properties": {
        "position": {
          "description": "XYZ position.",
          "items": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rotation": {
          "description": "Euler XYZ rotation in degrees.",
          "items": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "scale": {
          "description": "Dimensionless XYZ scale.",
          "items": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "type": "object"
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Explicit area-owned placement aggregate.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "area": {
          "$ref": "#/$defs/UlidText",
          "description": "Owning area identity."
        },
        "placements": {
          "description": "Instances in authored order.",
          "items": {
            "$ref": "#/$defs/Placement"
          },
          "type": "array"
        },
        "schema": {
          "const": "crpg.placements/1",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "area",
        "placements"
      ],
      "type": "object"
    }
  ],
  "title": "PlacementsDocument"
}
