{
  "$defs": {
    "FactionRelation": {
      "additionalProperties": false,
      "description": "Authored relation to another faction.",
      "properties": {
        "disposition": {
          "description": "Rules-interpreted integer disposition.",
          "format": "int32",
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "faction": {
          "$ref": "#/$defs/UlidText",
          "description": "Target faction identity."
        }
      },
      "required": [
        "faction",
        "disposition"
      ],
      "type": "object"
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Authored faction relations.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "relations": {
          "description": "Relations in authored order.",
          "items": {
            "$ref": "#/$defs/FactionRelation"
          },
          "type": "array"
        },
        "schema": {
          "const": "crpg.faction/1",
          "type": "string"
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "id",
        "slug",
        "name",
        "relations"
      ],
      "type": "object"
    }
  ],
  "title": "Faction"
}
