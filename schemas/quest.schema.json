{
  "$defs": {
    "ActionCall": {
      "additionalProperties": false,
      "description": "Declarative action invocation, without function pointers or a registry.",
      "properties": {
        "action_id": {
          "description": "Symbolic action vocabulary key.",
          "type": "string"
        },
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/DataValue"
          },
          "description": "Named tagged arguments.",
          "type": "object"
        }
      },
      "required": [
        "action_id",
        "args"
      ],
      "type": "object"
    },
    "DataValue": {
      "description": "Explicitly tagged values; signed and unsigned integers remain distinct.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Boolean value.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Signed integer.",
          "properties": {
            "type": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Unsigned integer.",
          "properties": {
            "type": {
              "const": "unsigned",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Raw fixed-point integer on the wire.",
          "properties": {
            "type": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Literal text, including Unicode.",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Authored-object reference.",
          "properties": {
            "type": {
              "const": "object_ref",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/UlidText"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered heterogeneous values.",
          "properties": {
            "type": {
              "const": "list",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Lexically keyed heterogeneous values.",
          "properties": {
            "type": {
              "const": "map",
              "type": "string"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "QuestState": {
      "additionalProperties": false,
      "description": "Identified quest state.",
      "properties": {
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable state identity."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "on_enter": {
          "description": "Entry actions in authored order.",
          "items": {
            "$ref": "#/$defs/ActionCall"
          },
          "type": "array"
        },
        "terminal": {
          "description": "Whether this is a terminal state.",
          "type": "boolean"
        },
        "transitions": {
          "description": "Transitions in authored order.",
          "items": {
            "$ref": "#/$defs/QuestTransition"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "terminal",
        "on_enter",
        "transitions"
      ],
      "type": "object"
    },
    "QuestTransition": {
      "additionalProperties": false,
      "description": "Authored quest transition.",
      "properties": {
        "condition": {
          "description": "Opaque condition expression.",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/UlidText",
          "description": "Destination state identity."
        }
      },
      "required": [
        "condition",
        "target"
      ],
      "type": "object"
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Authored quest state machine.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "entry": {
          "$ref": "#/$defs/UlidText",
          "description": "Initial state identity."
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "schema": {
          "const": "crpg.quest/1",
          "type": "string"
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        },
        "states": {
          "description": "Identified states in authored order.",
          "items": {
            "$ref": "#/$defs/QuestState"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "id",
        "slug",
        "name",
        "entry",
        "states"
      ],
      "type": "object"
    }
  ],
  "title": "Quest"
}
