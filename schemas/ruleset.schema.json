{
  "$defs": {
    "ActionPoolTemplate": {
      "additionalProperties": false,
      "description": "One action-pool template owned by a ruleset.",
      "properties": {
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Shared template identity for per-combatant runtime pools."
        },
        "max": {
          "description": "Maximum balance; sim initializes current to this value.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "refresh": {
          "$ref": "#/$defs/RefreshWire",
          "description": "Authored refresh trigger."
        }
      },
      "required": [
        "id",
        "max",
        "refresh"
      ],
      "type": "object"
    },
    "CreaturePersistenceWire": {
      "description": "Which placed creatures keep their state after an encounter.",
      "oneOf": [
        {
          "const": "survivors",
          "description": "Every placed creature that leaves or outlives an encounter keeps its state, and the dead stay dead.",
          "type": "string"
        },
        {
          "const": "registered",
          "description": "Only creatures that entered from a kept state keep it; authored participants spawn fresh at every start.",
          "type": "string"
        }
      ]
    },
    "EffectsOnExitWire": {
      "description": "What a creature's attached effects become when it leaves an encounter or the encounter ends.",
      "oneOf": [
        {
          "const": "suspend",
          "description": "They keep their remaining rounds and resume at the next entry.",
          "type": "string"
        },
        {
          "const": "strip",
          "description": "They are removed at leave and at release.",
          "type": "string"
        },
        {
          "const": "strip_at_release",
          "description": "They are removed at release and kept at leave.",
          "type": "string"
        }
      ]
    },
    "ExprWire": {
      "description": "One derived-stat expression node; mirrors the kernel expression tree.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A constant value.",
          "properties": {
            "type": {
              "const": "literal",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/StatValueWire"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The fully modified value of another stat of this ruleset, by name.",
          "properties": {
            "type": {
              "const": "stat",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Saturating integer or fixed-point addition.",
          "properties": {
            "type": {
              "const": "add",
              "type": "string"
            },
            "value": {
              "additionalProperties": false,
              "properties": {
                "left": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Left operand, evaluated first."
                },
                "right": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Right operand."
                }
              },
              "required": [
                "left",
                "right"
              ],
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Saturating integer or fixed-point subtraction.",
          "properties": {
            "type": {
              "const": "subtract",
              "type": "string"
            },
            "value": {
              "additionalProperties": false,
              "properties": {
                "left": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Left operand, evaluated first."
                },
                "right": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Right operand."
                }
              },
              "required": [
                "left",
                "right"
              ],
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Saturating integer or fixed-point multiplication.",
          "properties": {
            "type": {
              "const": "multiply",
              "type": "string"
            },
            "value": {
              "additionalProperties": false,
              "properties": {
                "left": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Left operand, evaluated first."
                },
                "right": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Right operand."
                }
              },
              "required": [
                "left",
                "right"
              ],
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Flooring division; a zero divisor is a kernel error.",
          "properties": {
            "type": {
              "const": "divide",
              "type": "string"
            },
            "value": {
              "additionalProperties": false,
              "properties": {
                "left": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Left operand, evaluated first."
                },
                "right": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Right operand."
                }
              },
              "required": [
                "left",
                "right"
              ],
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The smaller of two same-kind numeric values.",
          "properties": {
            "type": {
              "const": "min",
              "type": "string"
            },
            "value": {
              "additionalProperties": false,
              "properties": {
                "left": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Left operand, evaluated first."
                },
                "right": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Right operand."
                }
              },
              "required": [
                "left",
                "right"
              ],
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The larger of two same-kind numeric values.",
          "properties": {
            "type": {
              "const": "max",
              "type": "string"
            },
            "value": {
              "additionalProperties": false,
              "properties": {
                "left": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Left operand, evaluated first."
                },
                "right": {
                  "$ref": "#/$defs/ExprWire",
                  "description": "Right operand."
                }
              },
              "required": [
                "left",
                "right"
              ],
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "InitiativeWire": {
      "additionalProperties": false,
      "description": "Rolled initiative: dice plus stat values plus the participant's authored key.",
      "properties": {
        "bonus_stats": {
          "description": "Distinct non-health int stat names added to the roll, in authored order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dice": {
          "description": "Initiative dice notation, 1..=128 UTF-8 bytes.",
          "type": "string"
        }
      },
      "required": [
        "dice",
        "bonus_stats"
      ],
      "type": "object"
    },
    "LateJoinWire": {
      "description": "Where a turn-based first-round joiner acts when its initiative slot has passed.",
      "oneOf": [
        {
          "const": "next_round",
          "description": "It waits for the next round.",
          "type": "string"
        },
        {
          "const": "after_active",
          "description": "It acts right after the current turn.",
          "type": "string"
        }
      ]
    },
    "PackageId": {
      "description": "Immutable publication coordinate, distinct from an object ULID or slug.",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "type": "string"
    },
    "RefreshWire": {
      "description": "When an action pool refills to maximum.",
      "oneOf": [
        {
          "description": "Refills on every turn start.",
          "properties": {
            "type": {
              "const": "on_turn_start",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Refills on every round start.",
          "properties": {
            "type": {
              "const": "on_round_start",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Refills on the matching rest only.",
          "properties": {
            "type": {
              "const": "on_rest",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/RestId"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Refills on positive ticks divisible by the period.",
          "properties": {
            "type": {
              "const": "on_tick",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/TickPeriod"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Never refills.",
          "properties": {
            "type": {
              "const": "never",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "RestId": {
      "$ref": "#/$defs/UlidText",
      "description": "Opaque rest identity for authored refresh triggers."
    },
    "StatDecl": {
      "additionalProperties": false,
      "description": "One ruleset stat declaration.",
      "properties": {
        "derived": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExprWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "Formula evaluated before this stat's modifiers; absent means a base stat."
        },
        "kind": {
          "$ref": "#/$defs/StatKindWire",
          "description": "Declared value category."
        },
        "name": {
          "description": "Symbolic stat name referenced by abilities and creatures.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "StatKindWire": {
      "description": "Declared value category of one ruleset stat.",
      "oneOf": [
        {
          "const": "int",
          "description": "Whole-number integer stat.",
          "type": "string"
        },
        {
          "const": "fixed",
          "description": "Fixed-point stat.",
          "type": "string"
        },
        {
          "const": "bool",
          "description": "Flag stat.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Enum stat over a named domain.",
          "properties": {
            "enum": {
              "properties": {
                "enum_id": {
                  "description": "Nonempty domain identifier shared by every stat of the domain.",
                  "type": "string"
                },
                "variants": {
                  "description": "Distinct nonempty variant names in authored order.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "enum_id",
                "variants"
              ],
              "type": "object"
            }
          },
          "required": [
            "enum"
          ],
          "type": "object"
        },
        {
          "const": "tags",
          "description": "Tag-set stat.",
          "type": "string"
        },
        {
          "const": "dice",
          "description": "Dice-expression stat.",
          "type": "string"
        }
      ]
    },
    "StatValueWire": {
      "description": "One typed literal value; mirrors the kernel's symbolic stat value.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A whole number.",
          "properties": {
            "type": {
              "const": "int",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Core's raw fixed-point integer.",
          "properties": {
            "type": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A flag.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A member of a declared enum domain.",
          "properties": {
            "type": {
              "const": "enum",
              "type": "string"
            },
            "value": {
              "additionalProperties": false,
              "properties": {
                "enum_id": {
                  "description": "The enum domain identifier.",
                  "type": "string"
                },
                "variant": {
                  "description": "The selected variant within the domain.",
                  "type": "string"
                }
              },
              "required": [
                "enum_id",
                "variant"
              ],
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Distinct nonempty tag names.",
          "properties": {
            "type": {
              "const": "tags",
              "type": "string"
            },
            "value": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Dice notation, 1..=128 UTF-8 bytes.",
          "properties": {
            "type": {
              "const": "dice",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "TickPeriod": {
      "description": "Nonzero tick period for authored refresh triggers.",
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    },
    "VersionText": {
      "description": "Semantic version string; semver 1.x parsing is authoritative.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Authored ruleset: stat declarations, health designation, pools, abilities.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "abilities": {
          "description": "Ability identities in authored order.",
          "items": {
            "$ref": "#/$defs/UlidText"
          },
          "type": "array"
        },
        "attributes": {
          "description": "Names of the declared attributes (never containing health).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "creature_persistence": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreaturePersistenceWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who keeps creature state after an encounter; absent means survivors."
        },
        "effects_on_exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectsOnExitWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "What attached effects become at exit; absent means suspend."
        },
        "health_stat": {
          "description": "Name of the declared health stat.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "initiative": {
          "anyOf": [
            {
              "$ref": "#/$defs/InitiativeWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rolled initiative rule; absent means each participant's authored key alone."
        },
        "late_join": {
          "anyOf": [
            {
              "$ref": "#/$defs/LateJoinWire"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where a late first-round joiner acts; absent means the next round."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/PackageId",
          "description": "Immutable publication coordinate self-identifying the ruleset."
        },
        "pools": {
          "description": "Action-pool templates in authored order; the first is the primary pool.",
          "items": {
            "$ref": "#/$defs/ActionPoolTemplate"
          },
          "type": "array"
        },
        "round_ticks": {
          "description": "Ticks per real-time round, nonzero; absent means turn-based only.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "schema": {
          "const": "crpg.ruleset/2",
          "type": "string"
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        },
        "stats": {
          "description": "Declared stats in authored order.",
          "items": {
            "$ref": "#/$defs/StatDecl"
          },
          "type": "array"
        },
        "version": {
          "$ref": "#/$defs/VersionText",
          "description": "Published semantic version of the ruleset."
        }
      },
      "required": [
        "schema",
        "id",
        "slug",
        "name",
        "package",
        "version",
        "stats",
        "health_stat",
        "attributes",
        "pools",
        "abilities"
      ],
      "type": "object"
    }
  ],
  "title": "Ruleset"
}
