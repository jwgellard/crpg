{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "description": "Authored fixed-point bounding coordinates, without geometry validation.",
      "properties": {
        "max": {
          "description": "Maximum XYZ coordinates.",
          "items": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "min": {
          "description": "Minimum XYZ coordinates.",
          "items": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Authored area metadata, separate from placements and triggers.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "ambience": {
          "description": "Optional asset key; explicit null is required when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/Bounds",
          "description": "Authored fixed-point bounds."
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "neighbours": {
          "description": "Adjacent area identities in authored order.",
          "items": {
            "$ref": "#/$defs/UlidText"
          },
          "type": "array"
        },
        "schema": {
          "const": "crpg.area/1",
          "type": "string"
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "id",
        "slug",
        "name",
        "bounds",
        "neighbours",
        "ambience"
      ],
      "type": "object"
    }
  ],
  "title": "Area"
}
