{
  "$defs": {
    "DataValue": {
      "description": "Explicitly tagged values; signed and unsigned integers remain distinct.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Boolean value.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Signed integer.",
          "properties": {
            "type": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Unsigned integer.",
          "properties": {
            "type": {
              "const": "unsigned",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Raw fixed-point integer on the wire.",
          "properties": {
            "type": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Literal text, including Unicode.",
          "properties": {
            "type": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Authored-object reference.",
          "properties": {
            "type": {
              "const": "object_ref",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/UlidText"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered heterogeneous values.",
          "properties": {
            "type": {
              "const": "list",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Lexically keyed heterogeneous values.",
          "properties": {
            "type": {
              "const": "map",
              "type": "string"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/DataValue"
              },
              "type": "object"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    },
    "ValueType": {
      "description": "Declarative value category; containers hold tagged heterogeneous values.",
      "oneOf": [
        {
          "const": "bool",
          "description": "Boolean.",
          "type": "string"
        },
        {
          "const": "integer",
          "description": "Signed integer.",
          "type": "string"
        },
        {
          "const": "unsigned",
          "description": "Unsigned integer.",
          "type": "string"
        },
        {
          "const": "fixed",
          "description": "Fixed-point value.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Text.",
          "type": "string"
        },
        {
          "const": "object_ref",
          "description": "Authored-object reference.",
          "type": "string"
        },
        {
          "const": "list",
          "description": "Ordered tagged values.",
          "type": "string"
        },
        {
          "const": "map",
          "description": "Named tagged values.",
          "type": "string"
        }
      ]
    },
    "VarDecl": {
      "additionalProperties": false,
      "description": "Authored variable declaration; default-type consistency is a T011 check.",
      "properties": {
        "default": {
          "$ref": "#/$defs/DataValue",
          "description": "Initial tagged value."
        },
        "name": {
          "description": "Symbolic variable name.",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/VariableScope",
          "description": "Owning scope."
        },
        "value_type": {
          "$ref": "#/$defs/ValueType",
          "description": "Declared category."
        }
      },
      "required": [
        "name",
        "value_type",
        "default",
        "scope"
      ],
      "type": "object"
    },
    "VariableScope": {
      "description": "Ownership scope of a declared variable.",
      "oneOf": [
        {
          "const": "campaign",
          "description": "Campaign state.",
          "type": "string"
        },
        {
          "const": "world",
          "description": "World state.",
          "type": "string"
        },
        {
          "const": "area",
          "description": "Area state.",
          "type": "string"
        },
        {
          "const": "graph",
          "description": "Graph-local state.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Authored world and its area references.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "areas": {
          "description": "Area identities in authored order.",
          "items": {
            "$ref": "#/$defs/UlidText"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "schema": {
          "const": "crpg.world/1",
          "type": "string"
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        },
        "variables": {
          "description": "World variable declarations.",
          "items": {
            "$ref": "#/$defs/VarDecl"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "id",
        "slug",
        "name",
        "areas",
        "variables"
      ],
      "type": "object"
    }
  ],
  "title": "World"
}
