{
  "$defs": {
    "EncounterParticipant": {
      "additionalProperties": false,
      "description": "One encounter participant.",
      "properties": {
        "initiative": {
          "description": "Authored initiative key; ties are allowed.",
          "format": "int32",
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "placement": {
          "$ref": "#/$defs/UlidText",
          "description": "Placed-creature identity."
        }
      },
      "required": [
        "placement",
        "initiative"
      ],
      "type": "object"
    },
    "UlidText": {
      "description": "Core ULID: case-insensitive Crockford base32, I/L aliases for 1 and O for 0; first decoded digit at most 7.",
      "pattern": "^[0-7IiLlOo][0-9A-Ta-tV-Zv-z]{25}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Authored encounter: ruleset plus ordered participants.",
      "properties": {
        "_note": {
          "description": "Preserved author annotation.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/UlidText",
          "description": "Stable authored-object identity."
        },
        "name": {
          "description": "Locale key for the display name.",
          "type": "string"
        },
        "participants": {
          "description": "Participants in authored order.",
          "items": {
            "$ref": "#/$defs/EncounterParticipant"
          },
          "type": "array"
        },
        "ruleset": {
          "$ref": "#/$defs/UlidText",
          "description": "Ruleset identity governing this encounter."
        },
        "schema": {
          "const": "crpg.encounter/1",
          "type": "string"
        },
        "slug": {
          "description": "Renameable human-facing slug.",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "id",
        "slug",
        "name",
        "ruleset",
        "participants"
      ],
      "type": "object"
    }
  ],
  "title": "Encounter"
}
