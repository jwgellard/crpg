{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(python tools/agents/*)",
      "Bash(python3 tools/agents/*)",
      "Bash(python -m unittest discover -s tools/tests *)"
    ],
    "additionalDirectories": [
      "../crpg-slots/"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/agents/protect.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/agents/fmt_one.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/agents/context_meter.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/agents/handover.py\""
          }
        ]
      }
    ]
  }
}